---
import config from '../../site.config.json';
import Wordmark from '../components/Wordmark.astro';
import { url, isTodo } from '../utils';
import '../styles/global.css';
// School of Computing logo (computing.uga.edu, official file, unmodified; empty canvas hidden via CSS), UGA logo (brand.uga.edu) and favicon (www.uga.edu/favicon.ico), official files, used with the site owner's approval (confirm formal UGA approval before public launch); source: https://brand.uga.edu/wp-content/uploads/UGA_logo_ExtremeHoriz_FC_MARCM.png (official, unmodified).
const { title, description } = Astro.props;
const fallback = isTodo(config.description) ? `Research lab, ${config.affiliation}.` : config.description;
const desc = description ?? fallback;
const fullTitle = title ? `${title} | ${config.name}` : config.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname.replace(/\/$/, '');
const home = url().replace(/\/$/, '');
const isActive = (p: string) => (p === '' ? path === home : path.endsWith('/' + p.replace(/\/$/, '')));
---
<!doctype html>
<html lang={config.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('brand/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href={url('brand/apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600&display=swap" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="wrap masthead">
        <a class="lockup" href="https://computing.uga.edu/" aria-label="School of Computing, University of Georgia"><span class="shield" aria-hidden="true"><img src={url('brand/soc-logo-horizontal.png')} alt="" width="1800" height="596" /></span><span class="lockup-text"><span class="l1">School of Computing</span><span class="l2">University of Georgia</span></span></a>
        <a class="masthead-lab" href={url()}><Wordmark class="masthead-lab-name" /><span class="masthead-lab-kicker">{config.fullName}</span></a>
      </div>
    </header>
    <nav class="mainnav" aria-label="Main">
      <div class="wrap">
        <ul class="nav-desktop">
          {config.nav.map((n) => <li><a href={url(n.path)} aria-current={isActive(n.path) ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
        <details class="menu">
          <summary><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg><span>Menu</span></summary>
          <ul>
            {config.nav.map((n) => <li><a href={url(n.path)} aria-current={isActive(n.path) ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </details>
        <form class="nav-search" role="search" action={url('search/')} method="get">
          <label class="sr-only" for="site-search">Search this site</label>
          <input id="site-search" name="q" type="search" placeholder="Search" autocomplete="off" />
          <button type="submit" aria-label="Search"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg></button>
        </form>
      </div>
    </nav>
    <main id="main" class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-cols">
        <div><a class="lockup" href="https://computing.uga.edu/" aria-label="School of Computing, University of Georgia"><span class="shield" aria-hidden="true"><img src={url('brand/soc-logo-horizontal.png')} alt="" width="1800" height="596" /></span><span class="lockup-text"><span class="l1">School of Computing</span><span class="l2">University of Georgia</span></span></a><p class="footer-lab">{config.name}</p></div>
        <div><h2>Contact</h2>
          <address>{config.address}<br /><span class="email-text">{config.email}</span></address></div>
        <div><h2>Links</h2>
          <ul>{config.nav.map((n) => <li><a href={url(n.path)}>{n.label}</a></li>)}</ul></div>
      </div>
    </footer>
  </body>
</html>
