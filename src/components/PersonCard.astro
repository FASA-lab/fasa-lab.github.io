---
// Person card: photo (square crop) if present, else initials avatar.
import { url } from '../utils';
const { person } = Astro.props;
const name: string = person.name;
const initials = name.split(/\s+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const tone = [...name].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7) % 4;
---
<li class="card person">
  {person.photo
    ? <img class="avatar photo" src={url(person.photo)} alt={name} width="72" height="72" loading="lazy" />
    : <span class={`avatar tone-${tone}`} aria-hidden="true">{initials}</span>}
  <div class="person-body">
    <h3>{person.link ? <a href={person.link} target="_blank" rel="noopener noreferrer">{name}<span class="sr-only"> (opens in new tab)</span></a> : name}</h3>
    {person.role && <div class="role">{person.role}</div>}
    {person.topic && <div>{person.topic}</div>}
    {person.email && <a class="email" href={`mailto:${person.email}`}>{person.email}</a>}
  </div>
</li>
