---
// Person card: photo (round crop) if present, else a neutral silhouette.
import { url } from '../utils';
const { person } = Astro.props;
const name: string = person.name;
---
<li class="card person">
  {person.photo
    ? <img class="avatar photo" src={url(person.photo)} alt={name} width="72" height="72" loading="lazy" />
    : <span class="avatar avatar-blank" aria-hidden="true"><svg viewBox="0 0 64 64" focusable="false"><circle cx="32" cy="24" r="12" /><path d="M10 60c0-12.2 9.8-20 22-20s22 7.8 22 20z" /></svg></span>}
  <div class="person-body">
    <h3>{person.link ? <a href={person.link} target="_blank" rel="noopener noreferrer">{name}<span class="sr-only"> (opens in new tab)</span></a> : name}</h3>
    {person.role && <div class="role">{person.role}</div>}
    {person.topic && <div>{person.topic}</div>}
    {person.email && <span class="email email-text">{person.email}</span>}
  </div>
</li>
